-- ==========================================
-- 2. VARIABEL & LOGIC GAME
-- ==========================================
local isFarming = true       
local isAutoSkill = true     
local isAutoChest = true     
local selectedEnemyName = "ALL" 
local noclipConnection = nil
local movementConnection = nil

local skippedChests = {}
local currentChestTarget = nil
local chestStuckTimer = 0

local function getMapFolder()
    for _, folder in ipairs(workspace:GetChildren()) do
        if string.find(folder.Name, "Generated_") then
            return folder
        end
    end
    return nil
end

local function getEnemiesFolder()
    local map = getMapFolder()
    if map and map:FindFirstChild("NPCs") then
        return map.NPCs
    end
    return nil
end

local function getAliveTarget()
    local targetFolder = getEnemiesFolder()
    if not targetFolder then return nil end
    
    local fallbackEnemy = nil

    for _, enemy in ipairs(targetFolder:GetChildren()) do
        if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") then
            local humanoid = enemy:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health > 0 then
                if selectedEnemyName == "ALL" or enemy.Name == selectedEnemyName then
                    return enemy
                end
                if not fallbackEnemy then
                    fallbackEnemy = enemy
                end
            end
        end
    end
    return fallbackEnemy
end

local function getAliveChest()
    local map = getMapFolder()
    if map then
        for _, obj in ipairs(map:GetChildren()) do
            if string.find(obj.Name, "DungeonChest_") then
                if not skippedChests[obj] then
                    local targetPart = obj:FindFirstChild("Epic Chest Detailing 1 Plane") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    if targetPart then
                        return targetPart, obj
                    end
                end
            end
        end
    end
    return nil, nil
end

local function getCombatRemote()
    local playerFolder = ReplicatedStorage:FindFirstChild("Player")
    if playerFolder then
        local remotes = playerFolder:FindFirstChild("Remotes")
        if remotes and remotes:FindFirstChild("Inputs") then
            return remotes.Inputs:FindFirstChild("Attack")
        end
    end
    return nil
end

local function getSkillRemote()
    local playerFolder = ReplicatedStorage:FindFirstChild("Player")
    if playerFolder then
        local remotes = playerFolder:FindFirstChild("Remotes")
        if remotes and remotes:FindFirstChild("Inputs") then
            return remotes.Inputs:FindFirstChild("Skill")
        end
    end
    return nil
end

local function setupAntiPhysics(char, status)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local oldBV = hrp:FindFirstChild("AntiFall_BV")
    if oldBV then oldBV:Destroy() end

    if status then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "AntiFall_BV"
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Parent = hrp
        
        if noclipConnection then noclipConnection:Disconnect() end
        noclipConnection = RunService.Stepped:Connect(function()
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

-- MOVEMENT LOOP 
local function startMovementLoop()
    if movementConnection then movementConnection:Disconnect() end
    
    movementConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if isFarming then
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local myHRP = char.HumanoidRootPart
            
            local currentHeight = tonumber(HeightInput.Text) or defaultSpeedHeight
            local currentLerpSpeed = tonumber(SpeedInput.Text) or defaultLerpSpeed
            currentLerpSpeed = math.clamp(currentLerpSpeed, 0.001, 1)
            
            local targetPart = nil
            local isTargetingChest = false
            
            -- 1. UTAMAKAN CARI MUSUH DULU
            local targetEnemy = getAliveTarget()
            
            if targetEnemy then
                targetPart = targetEnemy:FindFirstChild("HumanoidRootPart")
                currentChestTarget = nil
                chestStuckTimer = 0
            
            -- 2. JIKA MUSUH HABIS, BARU CARI CHEST
            elseif isAutoChest then
                local chestPart, chestModel = getAliveChest()
                
                if chestPart then
                    if currentChestTarget == chestModel then
                        chestStuckTimer = chestStuckTimer + deltaTime
                        
                        -- Timeout 1 Detik
                        if chestStuckTimer >= chestSkipTimeout then
                            skippedChests[chestModel] = true 
                            currentChestTarget = nil
                            chestStuckTimer = 0
                            return 
                        end
                    else
                        currentChestTarget = chestModel
                        chestStuckTimer = 0
                    end
                    targetPart = chestPart
                    isTargetingChest = true
                else
                    currentChestTarget = nil
                    chestStuckTimer = 0
                end
            end
            
            -- EKSEKUSI TELEPORT & AUTO-COLLECT BYPASS
            if targetPart then
                if isTargetingChest then
                    currentHeight = 1 -- Fix Tinggi 1 di atas chest
                    
                    task.spawn(function()
                        if currentChestTarget then
                            for _, v in ipairs(currentChestTarget:GetDescendants()) do
                                if v:IsA("ProximityPrompt") then
                                    pcall(function() fireproximityprompt(v) end)
                                end
                                if firetouchinterest and v:IsA("BasePart") and v:FindFirstChild("TouchInterest") then
                                    pcall(function()
                                        firetouchinterest(myHRP, v, 0) 
                                        firetouchinterest(myHRP, v, 1)
                                    end)
                                end
                            end
                        end
                    end)
                end
                
                local targetPos = targetPart.Position + Vector3.new(0, currentHeight, 0)
                local goalCFrame = CFrame.new(targetPos, targetPart.Position)
                
                if currentLerpSpeed >= 1 then
                    char:PivotTo(goalCFrame)
                else
                    myHRP.CFrame = myHRP.CFrame:Lerp(goalCFrame, currentLerpSpeed)
                end
            end
        end
    end)
end

local function stopMovementLoop()
    if movementConnection then
        movementConnection:Disconnect()
        movementConnection = nil
    end
end

-- ATTACK & AUTO SKILL LOOP (FIX BUG MELAMUN)
task.spawn(function()
    while true do
        if isFarming then
            -- Fokus ke musuh (Cek target musuhnya langsung, ga peduli chest lagi on apa ngga)
            local targetEnemy = getAliveTarget() 
            local combatRemote = getCombatRemote()
            local skillRemote = getSkillRemote()
            local char = LocalPlayer.Character
            
            -- Kalau ketemu musuh, langsung BANTAI (karena movement juga pasti lagi ngejar musuh)
            if targetEnemy and char then
                local myHRP = char:FindFirstChild("HumanoidRootPart")
                local targetHRP = targetEnemy:FindFirstChild("HumanoidRootPart")
                
                if myHRP and targetHRP then
                    local direction = (targetHRP.Position - myHRP.Position).Unit
                    
                    pcall(function()
                        if combatRemote then
                            for i = 1, burstCount do
                                combatRemote:FireServer(direction.X, 0, direction.Z)
                            end
                        end
                        
                        if isAutoSkill and skillRemote then
                            for skillNum = 1, 4 do
                                skillRemote:FireServer(skillNum, "tap", 0, 0, 0)
                            end
                        end
                    end)
                end
            end
        end
        task.wait(attackDelay)
    end
end)

-- UI LOGIC: REFRESH DROPDOWN
local function refreshDropdown()
    for _, child in pairs(DropdownList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local ySize = 0
    
    local allBtn = Instance.new("TextButton")
    allBtn.Size = UDim2.new(1, 0, 0, 30)
    allBtn.Text = " [ ALL ENEMIES ]"
    allBtn.TextXAlignment = Enum.TextXAlignment.Left
    allBtn.TextColor3 = Color3.fromRGB(255, 235, 59)
    allBtn.Font = Enum.Font.GothamBold
    allBtn.TextSize = 13
    allBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 30)
    allBtn.Parent = DropdownList
    
    allBtn.MouseButton1Click:Connect(function()
        selectedEnemyName = "ALL"
        DropdownBtn.Text = "Target: ALL"
        DropdownList.Visible = false
        MainFrame.Size = UDim2.new(0, 220, 0, 295)
    end)
    ySize = ySize + 30
    
    local uniqueEnemies = {}
    local targetFolder = getEnemiesFolder()
    
    if targetFolder then
        for _, enemy in ipairs(targetFolder:GetChildren()) do
            if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") then
                if not uniqueEnemies[enemy.Name] then
                    uniqueEnemies[enemy.Name] = true
                    
                    local pBtn = Instance.new("TextButton")
                    pBtn.Size = UDim2.new(1, 0, 0, 30)
                    pBtn.Text = " " .. enemy.Name
                    pBtn.TextXAlignment = Enum.TextXAlignment.Left
                    pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    pBtn.Font = Enum.Font.Gotham
                    pBtn.TextSize = 13
                    pBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
                    pBtn.Parent = DropdownList
                    
                    pBtn.MouseButton1Click:Connect(function()
                        selectedEnemyName = enemy.Name
                        DropdownBtn.Text = "Target: " .. enemy.Name
                        DropdownList.Visible = false
                        MainFrame.Size = UDim2.new(0, 220, 0, 295)
                    end)
                    ySize = ySize + 30
                end
            end
        end
    end
    
    DropdownList.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

